# ═══════════════════════════════════════════════════════════════════
# AgriLink Frontend — Environment Variables (Vite)
# Windows path: C:\Users\YourName\Documents\agrilink\agrilink-frontend\.env
# ═══════════════════════════════════════════════════════════════════
# CRITICAL VITE RULE:
#   ALL frontend env variables MUST start with VITE_
#   Variables without this prefix are intentionally hidden from the browser.
#   This is a security feature — it prevents you from accidentally
#   exposing backend secrets in your React code.
# ═══════════════════════════════════════════════════════════════════

VITE_API_URL=http://localhost:5000/api/v1
# Every Axios API call in your React app will use this as the base URL.
# In production (Vercel), change this to your Render backend URL:
# VITE_API_URL=https://agrilink-api.onrender.com/api

VITE_APP_NAME=AgriLink
# Used in browser tab titles: document.title = import.meta.env.VITE_APP_NAME